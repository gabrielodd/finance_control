<div class="container my-5">
  <div class="row">
    <%= render 'settings/profile_sidebar' %>

    <div class="col-md-9">
      <!-- Payments List -->
      <div class="card mb-4">
        <h4 style="padding: 30px 30px 0px 30px;"><%= t('menu.payments') %></h4>
        <div class="card-body" style="padding: 40px;">
          <div class="row">
            <%= form_with url: payments_path, method: :patch, local: true do |form| %>
              <div class="col-md-12">
                <% @payments.each do |payment| %>
                  <div class="form-check">
                    <%= check_box_tag "payment_ids[]", payment.id, class: "form-check-input" %>
                    <%= label_tag "payment_#{payment.id}", I18n.t("pagamento.descriptions.#{payment.name.downcase}", default: payment.name), class: "form-check-label" %>
                  </div>
                <% end %>
                <br>
                <div class="form-group">
                  <%= form.submit "Save", class: "btn btn-success" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <h4 style="padding: 30px 30px 0px 30px;"><%= t('menu.create_payment') %></h4>
        <div class="card-body" style="padding: 40px;">
          <div class="row">
            <div class="col-md-12">
              <%= form_with model: Payment.new, url: payments_path, local: true do |form| %>
                <div class="form-group">
                  <%= form.label :name, "Payment Name" %>
                  <%= form.text_field :name, class: "form-control", required: true %>
                </div>

                <div class="form-group">
                  <%= form.submit "Save", class: "btn btn-success" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>